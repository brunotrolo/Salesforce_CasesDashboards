# Salesforce OAuth
SF_CLIENT_ID=your_salesforce_client_id
SF_CLIENT_SECRET=your_salesforce_client_secret
SF_REFRESH_TOKEN=your_salesforce_refresh_token
SF_INSTANCE_URL=https://login.salesforce.com
SF_REDIRECT_URI=https://api.reports.example.com/oauth/callback

# Service Configuration
SERVICE_NAME=mcp-client
SERVICE_PORT=3005
API_VERSION=v1
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database
DATABASE_URL=postgresql://reports_user:secure_password@localhost:5432/reports_db

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Elasticsearch
ELASTICSEARCH_HOST=localhost:9200
ELASTICSEARCH_INDEX_PREFIX=reports

# OAuth Configuration
OAUTH_TIMEOUT=30
OAUTH_RETRY_ATTEMPTS=3
OAUTH_RETRY_DELAY=2

# Tracing
TRACE_SAMPLE_RATE=0.1
JAEGER_ENABLED=false
JAEGER_HOST=localhost
JAEGER_PORT=6831
