# Auth Service Configuration

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Service Configuration
SERVICE_NAME=auth-service
SERVICE_PORT=3002
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://auth_user:secure_password@postgres:5432/auth_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration (for token blacklist and sessions)
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=86400

# Salesforce OAuth Configuration
SF_CLIENT_ID=your_salesforce_client_id
SF_CLIENT_SECRET=your_salesforce_client_secret
SF_INSTANCE_URL=https://login.salesforce.com

# MCP Client Service Configuration
MCP_CLIENT_URL=http://mcp-client:3005

# Security Configuration
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Elasticsearch Configuration (for logging)
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_PORT=9200
TRACE_SAMPLE_RATE=0.1

# RBAC Configuration
ENABLE_RBAC=true
